    {
      "type": "minecraft:boolean",
      "key": "shulker_mode",
      "label": "Shulker Mode"
    },
    {
      "type": "minecraft:text",
      "key": "lore",
      "label": "Lore"
    },
    {
      "type": "minecraft:single_option",
      "key": "color",
      "label": "Color",
      "options": [
        {
          "id": "white",
          "display": {
            "text": "White",
            "color": "white"
          }
        },
        {
          "id": "black",
          "display": {
            "text": "Black",
            "color": "black"
          }
        },
        {
